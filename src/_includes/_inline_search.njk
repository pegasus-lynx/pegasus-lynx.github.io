<section class="mb-8" aria-label="Filter entries">
  <div class="flex flex-col sm:flex-row items-stretch rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-card)] focus-within:border-[var(--accent-primary)] transition-colors">
    <div class="relative flex-1">
      <label for="search-input" class="sr-only">{{ searchPlaceholder }}</label>
      <span class="pointer-events-none absolute inset-y-0 left-3.5 flex items-center text-[var(--text-muted)]">
        {% icon "search", "w-4 h-4" %}
      </span>
      <input
        id="search-input"
        data-search-input
        type="search"
        placeholder="{{ searchPlaceholder }}"
        autocomplete="off"
        spellcheck="false"
        class="w-full h-11 rounded-t-xl sm:rounded-l-xl sm:rounded-tr-none bg-transparent pl-10 pr-10 text-base text-[var(--text-primary)] placeholder:text-[var(--text-muted)] focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-[var(--accent-primary)] transition-colors"
      >
      <button
        type="button"
        data-search-clear-query
        hidden
        aria-label="Clear search text"
        class="absolute inset-y-0 right-2.5 my-auto w-7 h-7 rounded-md flex items-center justify-center text-[var(--text-muted)] hover:text-[var(--text-primary)] cursor-pointer"
      >
        {% icon "close", "w-4 h-4" %}
      </button>
    </div>

    <div class="relative sm:w-52 shrink-0 border-t sm:border-t-0 sm:border-l border-[var(--border-subtle)]" data-topic-dropdown>
      <button
        type="button"
        data-topic-dropdown-btn
        aria-expanded="false"
        aria-haspopup="listbox"
        class="w-full h-11 px-3.5 rounded-b-xl sm:rounded-r-xl sm:rounded-bl-none bg-[var(--bg-surface)] flex items-center justify-between gap-2 font-mono text-xs uppercase tracking-wider text-[var(--text-secondary)] hover:text-[var(--text-primary)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-[var(--accent-primary)] transition-colors cursor-pointer"
      >
        <span class="inline-flex items-center gap-2">
          <span>Topics</span>
          <span data-topic-count hidden class="ec-topic-badge">0</span>
        </span>
        <span data-topic-chevron class="transition-transform duration-150">
          {% icon "chevron-down", "w-4 h-4" %}
        </span>
      </button>

      <div
        data-topic-dropdown-panel
        hidden
        class="absolute right-0 z-30 mt-2 w-full sm:w-72 rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-card)] shadow-xl p-2"
      >
        {% if filterTags.length > 8 %}
          <div class="mb-1.5">
            <label for="topic-filter-input" class="sr-only">Filter topics</label>
            <input
              id="topic-filter-input"
              data-topic-filter-input
              type="search"
              placeholder="Filter topics…"
              autocomplete="off"
              spellcheck="false"
              class="w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-canvas)] px-3 py-1.5 text-sm text-[var(--text-primary)] placeholder:text-[var(--text-muted)] focus:border-[var(--accent-primary)] focus:outline-none"
            >
          </div>
        {% endif %}

        <div
          role="listbox"
          aria-multiselectable="true"
          aria-label="Filter by topic"
          class="ec-topic-scroll max-h-60 overflow-y-auto space-y-0.5"
        >
          {% for tagObj in filterTags %}
            <button
              type="button"
              role="option"
              data-search-tag="{{ tagObj.name | slugify }}"
              data-search-tag-label="{{ tagObj.name }}"
              aria-selected="false"
              class="ec-topic-option"
            >
              <span class="ec-topic-checkbox">{% icon "check", "w-3 h-3" %}</span>
              <span class="flex-1 text-left truncate">{{ tagObj.name }}</span>
              <span class="ec-chip-count font-mono">{{ tagObj.items.length }}</span>
            </button>
          {% endfor %}
        </div>

        <p data-topic-filter-empty hidden class="py-3 text-center font-mono text-xs text-[var(--text-muted)]">
          No matching topics
        </p>

        <div data-topic-dropdown-footer hidden class="mt-1.5 pt-1.5 border-t border-[var(--border-subtle)] flex justify-end px-1">
          <button type="button" data-topic-clear class="font-mono text-[11px] uppercase tracking-wider text-[var(--accent-primary)] hover:underline cursor-pointer">
            Clear topics
          </button>
        </div>
      </div>
    </div>
  </div>

  <div data-active-tags-row hidden class="mt-3 flex flex-wrap items-center gap-1.5">
    <div data-active-tags-list class="contents"></div>
    <button type="button" data-search-reset class="ml-1 font-mono text-xs uppercase tracking-wider text-[var(--accent-primary)] hover:underline underline-offset-4 cursor-pointer">
      Clear all
    </button>
  </div>

  <div data-search-status aria-live="polite" hidden class="mt-3 font-mono text-xs uppercase tracking-wider text-[var(--text-muted)]"></div>
</section>
