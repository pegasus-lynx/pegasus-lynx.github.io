{% set resolvedTagBase = tagBaseUrl or '/search/' %}
<div data-tag-list class="{{ tagListClass or 'flex flex-wrap gap-1.5' }}">
  {% for tag in tagItems %}
    {% if tag != 'Blog' and tag != 'Project' %}
      <a href="{{ resolvedTagBase }}?tag={{ tag | slugify }}" data-tag-item data-tag-slug="{{ tag | slugify }}" class="ec-chip">{{ tag }}</a>
    {% endif %}
  {% endfor %}
  <span data-tag-more class="ec-chip ec-chip-more" hidden></span>
</div>
