---
title: Blogs
description: Essays, book notes, and engineering reflections on building software.
permalink: /blogs/
---
<main class="max-w-4xl mx-auto px-6 md:px-10 py-12 md:py-16" data-inline-search-root data-inline-search-type="blog">
  <header class="mb-8">
    <div class="ec-kicker mb-2">Writing</div>
    <h1 class="font-display text-4xl md:text-5xl font-bold tracking-tight mb-4">
      Essays &amp; Notes
    </h1>
    <p class="text-lg text-[var(--text-secondary)] max-w-2xl leading-relaxed">
      Articles, engineering deep dives, and book summaries I've written and collected over the years.
    </p>
  </header>

  {% set searchPlaceholder = "Search essays by title, topic, or content…" %}
  {% set filterTags = collections.blogTags %}
  {% include "_inline_search.njk" %}

  <div data-search-results class="space-y-6">
    {% for post in collections.blogsSorted %}
      {% set postHref = post.data.external_url or post.url %}
      {% set isExternalPost = true if post.data.external_url else false %}
      <article data-inline-card="{{ postHref }}" class="ec-card ec-card-interactive p-6 md:p-8">
        <div class="font-mono text-xs uppercase tracking-wider text-[var(--accent-secondary)] mb-2">
          {{ post.data.publishdate | postDate }} · {{ post.data.readingtime }} read{% if post.data.external_site %} · {{ post.data.external_site }}{% endif %}
        </div>
        <h2 class="font-display text-2xl font-bold leading-snug mb-2.5">
          <a href="{{ postHref }}"{% if isExternalPost %} target="_blank" rel="noopener noreferrer"{% endif %}
             class="hover:text-[var(--accent-primary)] transition-colors">
            {{ post.data.title }}
          </a>
        </h2>
        <p class="text-[var(--text-secondary)] leading-relaxed mb-5">
          {{ post.data.description }}
        </p>
        <div class="flex flex-wrap items-center justify-between gap-3">
          {% set tagItems = post.data.tags %}
          {% set tagBaseUrl = "/blogs/" %}
          {% set tagListClass = "flex flex-wrap gap-2" %}
          {% include "_card_tags.njk" %}
          <a href="{{ postHref }}"{% if isExternalPost %} target="_blank" rel="noopener noreferrer"{% endif %}
             class="inline-flex items-center gap-1 font-mono text-xs uppercase tracking-wider text-[var(--accent-primary)] hover:underline underline-offset-4">
            <span>{% if post.data.external_site %}Read on {{ post.data.external_site }}{% else %}Read essay{% endif %}</span>
            {% if isExternalPost %}
              {% icon "arrow-up-right", "w-3.5 h-3.5" %}
            {% else %}
              {% icon "arrow-right", "w-3.5 h-3.5" %}
            {% endif %}
          </a>
        </div>
      </article>
    {% endfor %}
  </div>

  <div data-search-empty hidden class="ec-card p-8 text-center">
    <p class="font-display text-lg font-semibold text-[var(--text-primary)] mb-1">
      No matching essays
    </p>
    <p class="text-sm text-[var(--text-secondary)] mb-4">
      Try removing a topic filter or using fewer keywords.
    </p>
    <button type="button" data-search-empty-reset class="ec-btn-secondary cursor-pointer">
      Reset filters
    </button>
  </div>
</main>
